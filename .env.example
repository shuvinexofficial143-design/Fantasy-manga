# Fantasy Cinematic Studio — image providers
# Same authorization pattern used by StoryFrame. Keep all secret values in Vercel Environment Variables.

# Choose the image provider/model in Images; credentials stay server-side.
FANTASY_DEFAULT_IMAGE_PROVIDER=gemini

# Google Cloud Vertex AI project + region
# Use the PROJECT ID (for example my-project-123), not only the display name.
VERTEX_AI_PROJECT_ID=
VERTEX_AI_LOCATION=global

# Story / continuity analysis
GEMINI_STORY_MODEL=gemini-3.1-pro-preview
VERTEX_STORY_TIMEOUT_MS=120000

# Full cinematic image generation
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# Authentication — choose ONE method.
# Recommended production method: paste the complete service-account JSON as ONE Vercel secret value.
VERTEX_AI_SERVICE_ACCOUNT_JSON=

# Optional alternative to the JSON value above: base64-encode the full service-account JSON.
VERTEX_AI_SERVICE_ACCOUNT_BASE64=

# Simpler key-based method.
# This must be a Google Cloud authorization key / Vertex-compatible API key allowed for aiplatform.googleapis.com.
VERTEX_AI_API_KEY=

# Backwards-compatible aliases accepted by the code. Normally you do NOT need to set these
# when the VERTEX_AI_* variables above are already configured.
# GOOGLE_CLOUD_PROJECT_ID=
# GOOGLE_CLOUD_LOCATION=global
# GOOGLE_CLOUD_API_KEY=
# GEMINI_API_KEY=

# Direct SenseNova (international region; use a matching region key and URL)
SENSENOVA_API_KEY=
SENSENOVA_BASE_URL=https://token.sensenova.ai/v1
SENSENOVA_IMAGE_MODEL=sensenova-u1.5-lite
